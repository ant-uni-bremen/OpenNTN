date-released: "2026-10-21"
repository-code: "https://github.com/ant-uni-bremen/OpenNTN"
url: "https://pypi.org/project/openntn/"
keywords:
  - 3GPP TR 38.811
  - non-terrestrial networks
  - channel models
  - satellite communications
  - Sionna
  - PyTorch
